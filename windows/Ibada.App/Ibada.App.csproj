<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Ibada</AssemblyName>
    <RootNamespace>Ibada.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms n'est utilisé que pour lire les écrans ; ses espaces de noms implicites entrent en conflit avec WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ibada.Core\Ibada.Core.csproj" />
  </ItemGroup>

</Project>
