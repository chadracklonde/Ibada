<Window x:Class="IbadaPrototype.ProjectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ibada — Projection"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="Black"
        WindowStartupLocation="Manual"
        Topmost="True">
    <Grid>
        <MediaElement x:Name="BackgroundVideo" LoadedBehavior="Manual"
                      UnloadedBehavior="Manual" Stretch="UniformToFill"
                      IsMuted="True" />
        <TextBlock x:Name="SlideText"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" Foreground="White"
                   FontSize="72" FontWeight="Bold" Margin="40"
                   TextWrapping="Wrap">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="5" />
            </TextBlock.Effect>
        </TextBlock>
        <TextBlock x:Name="LogoText" Visibility="Collapsed"
                   Text="IBADA" Foreground="White" FontSize="120"
                   FontWeight="Bold" HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
    </Grid>
</Window>
