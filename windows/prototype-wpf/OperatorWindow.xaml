<Window x:Class="IbadaPrototype.OperatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ibada — Opérateur (V0)" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#111">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barre de contrôle : choix de l'écran de projection -->
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    Margin="12" VerticalAlignment="Center">
            <TextBlock Text="Écran de projection :" Foreground="White"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="ScreenCombo" Width="320"
                      SelectionChanged="ScreenCombo_SelectionChanged" />
            <Button Content="Ouvrir la projection" Padding="12,6" Margin="12,0,0,0"
                    Click="OpenProjection_Click" />
            <Button Content="Écran noir" Padding="12,6" Margin="8,0,0,0"
                    Click="BlackScreen_Click" />
            <Button Content="Logo" Padding="12,6" Margin="8,0,0,0"
                    Click="Logo_Click" />
        </StackPanel>

        <!-- Aperçu -->
        <Border Grid.Row="1" Margin="16" Background="Black">
            <Grid>
                <MediaElement x:Name="BackgroundVideo" LoadedBehavior="Manual"
                              UnloadedBehavior="Manual" Stretch="UniformToFill"
                              IsMuted="True" />
                <TextBlock x:Name="SlideText"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Foreground="White"
                           FontSize="56" FontWeight="Bold" Margin="32">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="4" />
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="12">
            <Button Content="◀ Précédent" Padding="16,8" Margin="0,0,8,0"
                    Click="Prev_Click" />
            <Button Content="Suivant ▶" Padding="16,8" Margin="0,0,8,0"
                    Click="Next_Click" />
            <TextBlock x:Name="StatusText" Foreground="#aaa"
                       VerticalAlignment="Center" Margin="16,0,0,0"
                       Text="Prêt." />
        </StackPanel>
    </Grid>
</Window>
